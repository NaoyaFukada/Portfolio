---
import SectionHeader from '../common/SectionHeader.astro';
import {contactItems} from '../../data/contact';

// A value may wrap after a URL's last '/' or before an email's '@', never inside a name.
const splitValue = (value: string) => {
    const at = value.indexOf('@');
    const i = at !== -1 ? at : value.lastIndexOf('/') + 1;
    return i <= 0 ? [value, ''] : [value.slice(0, i), value.slice(i)];
};
---

<section id="contact" class="contact">
    <SectionHeader
        mainText="Get In"
        highlightText="Touch"
        highlightClass="text-indigo-400"
        underlineClass="bg-indigo-400"
        subtitle="Feel free to reach out for collaborations or just a friendly chat"
    />

    <div class="contact-grid">
        {contactItems.map((item) => (
            <div class="card group">
                <div class="flex items-start gap-4">
                    <div class={`icon-wrapper ${item.color}`}>
                        <i class={item.icon}></i>
                    </div>
                    <div class="flex flex-col gap-1 flex-1">
                        <span class="text-sm text-slate-400 font-medium">
                            {item.label}
                        </span>
                        {item.href ? (
                            <a 
                                href={item.href} 
                                class={`contact-value ${item.color}`}
                                target={item.href.startsWith('http') || item.href.startsWith('/') ? '_blank' : undefined}
                                rel={item.href.startsWith('http') || item.href.startsWith('/') ? 'noopener noreferrer' : undefined}
                            >
                                {splitValue(item.value)[0]}{splitValue(item.value)[1] && <><wbr /><span class="whitespace-nowrap">{splitValue(item.value)[1]}</span></>}
                            </a>
                        ) : (
                            <span class="contact-value">{item.value}</span>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>

</section>

<style>
    @reference "tailwindcss";

    .contact {
        @apply max-w-7xl mx-auto px-6 my-20 md:my-40 scroll-mt-20 z-1;
    }

    /* Flex, not grid: a short last row is centred instead of leaving an empty slot. */
    .contact-grid {
        @apply flex flex-wrap justify-center gap-6 mt-16;
    }

    .contact-grid > .card {
        @apply basis-full md:basis-[calc((100%-1.5rem)/2)] lg:basis-[calc((100%-3rem)/3)];
    }

    .card {
        @apply rounded-xl p-6 transition-all duration-300;
        background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid #334155;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
    }

    .card:hover {
        @apply -translate-y-2;
        border-color: #475569;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }

    .icon-wrapper {
        @apply text-3xl p-3 rounded-lg transition-all duration-300;
        background: rgba(255, 255, 255, 0.05);
    }

    .card:hover .icon-wrapper {
        @apply scale-110;
        background: rgba(255, 255, 255, 0.1);
    }

    .contact-value {
        @apply text-slate-200 font-medium wrap-anywhere transition-colors duration-300;
    }

    a.contact-value:hover {
        @apply underline;
    }
</style>