---
import SectionHeader from "../common/SectionHeader.astro";
import FilterTabs from "../common/FilterTabs.astro";
import {projects} from "../../data/projects";

const filters = [
    {label: "All Projects", value: "all", icon: "*"},
    {label: "Full Stack", value: "fullstack", icon: "</>"},
    {label: "Frontend", value: "frontend", icon: "🎨"},
    {label: "Backend", value: "backend", icon: "⚙️"},
]

// A filter earns its place once there are two rows of cards in more than one category.
const showFilter = projects.length >= 6 && new Set(projects.map((p) => p.category)).size > 1;
// Columns follow the number of cards, so two cards never leave an empty third column.
const columns = projects.length >= 3 ? "cols-3" : "cols-2";
---

<section id="projects" class="projects">
    <SectionHeader 
        mainText="My" 
        highlightText="Projects" 
        highlightClass="text-emerald-400" 
        underlineClass="bg-emerald-400"
        subtitle="Building solutions with code, one project at a time" 
    />

    {showFilter && (
        <FilterTabs
            filters={filters}
            sectionColor="#10b981"
            gradientStart="rgba(16, 185, 129, 0.15)"
            gradientEnd="rgba(6, 182, 212, 0.15)"
            boxShadow="rgba(16, 185, 129, 0.2)"
        />
    )}

    <div class={`projects-container ${columns}`}>
        {projects.map((project) => (
            <div class="project-item" data-category={project.category}>
                <div class="project-inner">
                    <div class="project-front">
                        <div class="front-header">
                            <div class="folder-icon">
                                <i class="fa-regular fa-folder-open"></i>
                            </div>
                            <!-- Names what the back face holds; the links themselves live there (hover, tap or Tab flips the card). -->
                            <span class="links-label">
                                {[project.github && "Code", project.demo && "Live demo"].filter(Boolean).join(" · ") || "No public code"}
                            </span>
                        </div>
                        <span class="proof-tag">{project.proof}</span>
                        <h3 class="project-title">{project.title}</h3>
                        {project.outcome && <p class="project-outcome">{project.outcome}</p>}
                        <p class="project-description">{project.description}</p>

                        <div class="tech-list">
                            {project.technologies.map((tech, i) => (
                                <span class="tech-item">
                                    {tech}{i !== project.technologies.length - 1 && ', '}
                                </span>
                            ))}
                        </div>
                    </div>
                    <div class="project-back">
                        <div class="w-full">
                            <h3 class="back-title">{project.title}</h3>
                            <div class="back-divider"></div>
                            <div class="back-features">
                                {project.features.map((feature) => (
                                    <div class="feature-line">
                                        <span class="feature-bullet">▸</span>
                                        <span>{feature}</span>
                                    </div>
                                ))}
                            </div>
                            <div class="back-actions">
                                {project.github && (
                                    <a href={project.github} class="back-button github" target="_blank" rel="noopener noreferrer">
                                        <i class="fa-brands fa-github"></i>
                                        View Code
                                    </a>
                                )}
                                {project.demo && (
                                    <a href={project.demo} class="back-button demo" target="_blank" rel="noopener noreferrer">
                                        <i class="fa-solid fa-external-link-alt"></i>
                                        Live Demo
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>

<script>
    import { initializeFilter } from "../../utils/filter";
    if (document.querySelector("#projects .filter-tab")) {
        initializeFilter("#projects", ".project-item");
    }

    if ('ontouchstart' in window) {
        const items = document.querySelectorAll('.project-item');
        items.forEach((item) => {
            item.addEventListener('click', ()=> {
                item.classList.toggle('is-flipped');
            });
        });
    }
</script>

<style>
    @reference "tailwindcss";

    .projects {
        @apply max-w-7xl mx-auto px-6 my-20 md:my-40 scroll-mt-20 z-1
    }

    /* Projects Container */
    .projects-container {
        @apply grid grid-cols-1 gap-6;
    }

    .projects-container.cols-2 {
        @apply md:grid-cols-2;
    }

    /* Flex, not grid, as in Contact: a short last row is centred instead of leaving an empty slot. */
    .projects-container.cols-3 {
        @apply flex flex-wrap justify-center;
    }

    .projects-container.cols-3 > .project-item {
        @apply basis-full md:basis-[calc((100%-1.5rem)/2)] lg:basis-[calc((100%-3rem)/3)];
    }

    .project-item {
        @apply transition-all duration-500;
        perspective: 1000px;
        min-height: 350px;
    }

    .project-item.hidden {
        @apply opacity-0 scale-95 pointer-events-none;
        height: 0;
        margin: 0;
        min-height: 0;
    }

    /* Both faces share one grid cell, so the card is as tall as its taller face. */
    .project-inner {
        @apply relative grid h-full w-full transition-transform duration-700 motion-reduce:transition-none;
        transform-style: preserve-3d;
    }

    @media (hover: hover) {
        .project-item:hover .project-inner {
            transform: rotateY(180deg);
        }
    }

    .project-item:focus-within .project-inner,
    .project-item.is-flipped .project-inner {
        transform: rotateY(180deg);
    }


    .project-front, .project-back {
        @apply w-full h-full rounded-xl p-6;
        grid-area: 1 / 1;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
        border: 1px solid #334155;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
    }

    .project-front {
        @apply flex flex-col;
    }

    /* Project Front */
    .front-header {
        @apply flex items-center justify-between mb-4;
    }

    .folder-icon {
        @apply text-4xl text-emerald-400;
    }



    .proof-tag {
        @apply self-start mb-3 px-2.5 py-0.5 rounded-full text-xs font-medium text-emerald-300
            bg-emerald-400/10 border border-emerald-400/30;
    }

    .links-label {
        @apply text-xs text-slate-400;
    }

    .project-outcome {
        @apply text-emerald-300 text-sm font-medium mb-2;
    }

    .project-title {
        @apply text-xl font-bold text-white mb-3;
    }

    .project-description {
        @apply text-slate-300 text-sm leading-relaxed mb-auto;
    }

    /* Room for two lines of tech from md up (padding + border + 2 × 1rem lines + the row gap),
       so the dividers in a row line up whether a card's list wraps or not. */
    .tech-list {
        @apply flex flex-wrap content-start gap-2 mt-6 pt-6 border-t border-slate-700
              md:min-h-[calc(1.5rem+1px+2rem+0.5rem)];
    }

    .tech-item {
        @apply text-xs text-cyan-300 font-mono;
    }

    /* Project Back */
    .project-back {
        transform: rotateY(180deg);
        @apply flex items-center justify-center;
        background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
    }

    .back-title {
        @apply text-2xl font-bold text-center mb-4;
        background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .back-divider {
        @apply w-16 h-1 bg-gradient-to-r from-emerald-400 to-cyan-400 mx-auto rounded-full mb-6;
    }

    .back-features {
        @apply space-y-3 mb-8 ml-4;
    }

    .feature-line {
        @apply flex items-center gap-3 text-slate-300;
    }

    .feature-bullet {
        @apply text-emerald-400 font-bold;
    }

    .back-actions {
        @apply flex gap-3 justify-center;
    }

    .back-button {
        @apply flex items-center gap-2 px-4 py-2 rounded-lg font-medium text-sm
            transition-all duration-300 border
            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400;
    }

    .back-button:hover {
        transform: translateY(-2px);
    }

    .back-button.github {
        background: rgba(16, 185, 129, 0.1);
        border-color: rgba(16, 185, 129, 0.3);
        color: #10b981;
    }

    .back-button.github:hover {
        background: rgba(16, 185, 129, 0.2);
        border-color: #10b981;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .back-button.demo {
        background: rgba(6, 182, 212, 0.1);
        border-color: rgba(6, 182, 212, 0.3);
        color: #06b6d4;
    }

    .back-button.demo:hover {
        background: rgba(6, 182, 212, 0.2);
        border-color: #06b6d4;
        box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
    }
</style>